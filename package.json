{
  "name": "clew",
  "version": "0.1.0-alpha.3",
  "description": "Check state charts and workflow sets, and prove each named flow.",
  "bin": {
    "clew": "dist/cli.js"
  },
  "files": [
    "dist",
    "build-info.json"
  ],
  "scripts": {
    "clew": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:imports": "bash scripts/check-imports.sh",
    "test:architecture": "tsx --test tests/architecture/rules.test.ts",
    "check": "tsc --noEmit && npm run check:dependencies && npm run check:imports && npm run test:architecture && npm run test:spec",
    "test:spec": "tsx --test tests/spec/*.test.ts",
    "test:e2e": "playwright test",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node dist/cli.js verify examples/todo/b-full.yaml examples/todo/workflows.yaml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goan15910/clew.git"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@xstate/graph": "^3.0.4",
    "commander": "^15.0.0",
    "compromise": "14.19.0",
    "xstate": "^5.33.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bundleDependencies": [
    "@commander-js/extra-typings",
    "@xstate/graph",
    "commander",
    "compromise",
    "xstate",
    "yaml",
    "zod"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "cruiser-typescript": "file:tools/cruiser-typescript",
    "dependency-cruiser": "^18.7.0",
    "playwright-ctrf-json-reporter": "^0.0.23",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
