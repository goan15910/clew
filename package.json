{
  "name": "clew",
  "version": "0.1.0",
  "description": "Check state charts and workflow sets, and prove each named flow.",
  "bin": {
    "clew": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clew": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "tsx scripts/check-dependencies.ts",
    "check": "tsc --noEmit && tsx scripts/check-dependencies.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node dist/cli.js verify examples/todo/b-full.yaml examples/todo/workflows.yaml examples/todo/mapping.yaml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goan15910/clew.git"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@xstate/graph": "^3.0.4",
    "commander": "^15.0.0",
    "xstate": "^5.33.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bundleDependencies": [
    "@commander-js/extra-typings",
    "@xstate/graph",
    "commander",
    "xstate",
    "yaml",
    "zod"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
