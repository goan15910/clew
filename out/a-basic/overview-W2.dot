digraph G {
  rankdir=LR; pad=0.3; nodesep=0.5; ranksep=0.9; bgcolor="white";
  labelloc=t; fontname="Helvetica"; fontsize=18; label=<<B>Overview: a-basic, path of W2 "Snooze and resume" highlighted</B>>;
  node [shape=box style="rounded,filled" fillcolor="#f6f8fa" color="#57606a" fontname="Helvetica" fontsize=13 margin="0.18,0.08"];
  edge [fontname="Helvetica" fontsize=11 color="#6e7781" fontcolor="#24292f" arrowsize=0.8];
  __start [shape=circle label="" width=0.22 style=filled fillcolor=black];
  draft [label=<<B>Draft</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">title set, not in list</FONT>> fillcolor="#ddf4ff" color="#0969da" penwidth=2];
  todo [label=<<B>Todo</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">listed, started_at = null</FONT>> fillcolor="#ddf4ff" color="#0969da" penwidth=2];
  inProgress [label=<<B>In Progress</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">started_at set</FONT>> fillcolor="#ddf4ff" color="#0969da" penwidth=2];
  snoozed [label=<<B>Snoozed</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">wake_at set, hidden</FONT>> fillcolor="#ddf4ff" color="#0969da" penwidth=2];
  done [label=<<B>Done</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">completed_at set</FONT>> fillcolor="#ddf4ff" color="#0969da" penwidth=2];
  archived [label=<<B>Archived</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">listed = false, read-only</FONT>> peripheries=2];
  deleted [label=<<B>Deleted</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">row removed</FONT>> peripheries=2];
  __start -> draft [label="new task"];
  draft -> todo [label=<<B><FONT COLOR="#0969da">(1) SUBMIT</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user; if title not empty</FONT>> color="#0969da" penwidth=3];
  draft -> deleted [label=<<B>DELETE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>> color="#c8ccd1" fontcolor="#8c959f"];
  todo -> inProgress [label=<<B><FONT COLOR="#0969da">(2) START</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>> color="#0969da" penwidth=3];
  todo -> snoozed [label=<<B>SNOOZE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>> color="#c8ccd1" fontcolor="#8c959f"];
  todo -> deleted [label=<<B>DELETE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>> color="#c8ccd1" fontcolor="#8c959f"];
  inProgress -> snoozed [label=<<B><FONT COLOR="#0969da">(3) SNOOZE</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>> color="#0969da" penwidth=3];
  inProgress -> done [label=<<B><FONT COLOR="#0969da">(5) COMPLETE</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>> color="#0969da" penwidth=3];
  inProgress -> archived [label=<<B>ARCHIVE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>> color="#c8ccd1" fontcolor="#8c959f"];
  snoozed -> inProgress [label=<<B><FONT COLOR="#0969da">(4) RESUME</FONT></B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user or timer</FONT>> color="#0969da" penwidth=3];
  done -> todo [label=<<B>REOPEN</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>> color="#c8ccd1" fontcolor="#8c959f"];
  done -> archived [label=<<B>ARCHIVE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>> color="#c8ccd1" fontcolor="#8c959f"];
}