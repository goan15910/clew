digraph G {
  rankdir=LR; pad=0.3; nodesep=0.25; ranksep=0.35; newrank=true;
  labelloc=t; fontname="Helvetica"; fontsize=18; label=<<B>W8: Rule: unfinished task cannot be archived</B>>;
  node [shape=box style="rounded,filled" fillcolor="#f6f8fa" color="#57606a" fontname="Helvetica" fontsize=12 height=0.4];
  edge [fontname="Helvetica" fontsize=10 color="#57606a"];
  subgraph cluster_0 { style="rounded" color="#cf222e" penwidth=1.5; label=""; 
    w0_h [shape=plaintext style="" label=<<FONT COLOR="#cf222e"><B>W8 FAIL</B></FONT><BR/><FONT POINT-SIZE="10">Rule: unfinished task cannot be archived</FONT>>];
    w0_s0 [label="Draft"];
    w0_h -> w0_s0 [style=invis];
    w0_s1 [label="Todo"];
    w0_s0 -> w0_s1 [label=<<B>SUBMIT</B>>];
    w0_s2 [label="In Progress"];
    w0_s1 -> w0_s2 [label=<<B>START</B>>];
    w0_s3 [label="Archived (should be refused)" fillcolor="#ffebe9" color="#cf222e" fontcolor="#cf222e"];
    w0_s2 -> w0_s3 [label=<<B>ARCHIVE</B>> color="#cf222e" fontcolor="#cf222e" penwidth=2];
    w0_why [shape=note style=filled fillcolor="#fff8c5" color="#bf8700" fontsize=10 label="should have been refused at step 3 (ARCHIVE) but the model allows the whole sequence, ending in Archived"];
    w0_s3 -> w0_why [style=dotted arrowhead=none];
  }
  { rank=same; w0_h }
}