digraph G {
  rankdir=LR; pad=0.3; nodesep=0.5; ranksep=0.9; bgcolor="white";
  labelloc=t; fontname="Helvetica"; fontsize=18; label=<<B>State chart: candidate a-basic</B>>;
  node [shape=box style="rounded,filled" fillcolor="#f6f8fa" color="#57606a" fontname="Helvetica" fontsize=13 margin="0.18,0.08"];
  edge [fontname="Helvetica" fontsize=11 color="#6e7781" fontcolor="#24292f" arrowsize=0.8];
  __start [shape=circle label="" width=0.22 style=filled fillcolor=black];
  draft [label=<<B>Draft</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">title set, not in list</FONT>> ];
  todo [label=<<B>Todo</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">listed, started_at = null</FONT>> ];
  inProgress [label=<<B>In Progress</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">started_at set</FONT>> ];
  snoozed [label=<<B>Snoozed</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">wake_at set, hidden</FONT>> ];
  done [label=<<B>Done</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">completed_at set</FONT>> ];
  archived [label=<<B>Archived</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">listed = false, read-only</FONT>> peripheries=2];
  deleted [label=<<B>Deleted</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">row removed</FONT>> peripheries=2];
  __start -> draft [label="new task"];
  draft -> todo [label=<<B>SUBMIT</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user; if title not empty</FONT>>];
  draft -> deleted [label=<<B>DELETE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>>];
  todo -> inProgress [label=<<B>START</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>>];
  todo -> snoozed [label=<<B>SNOOZE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>>];
  todo -> deleted [label=<<B>DELETE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>>];
  inProgress -> snoozed [label=<<B>SNOOZE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>>];
  inProgress -> done [label=<<B>COMPLETE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>>];
  inProgress -> archived [label=<<B>ARCHIVE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>>];
  snoozed -> inProgress [label=<<B>RESUME</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user or timer</FONT>>];
  done -> todo [label=<<B>REOPEN</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>>];
  done -> archived [label=<<B>ARCHIVE</B><BR/><FONT POINT-SIZE="9" COLOR="#57606a">user</FONT>>];
}