{
  "id": "todoTask",
  "initial": "draft",
  "states": [
    {
      "id": "draft",
      "label": "Draft",
      "workflowState": "editing",
      "data": "title set, not in list",
      "final": false
    },
    {
      "id": "todo",
      "label": "Todo",
      "workflowState": "open",
      "data": "listed, started_at = null",
      "final": false
    },
    {
      "id": "inProgress",
      "label": "In Progress",
      "workflowState": "active",
      "data": "started_at set",
      "final": false
    },
    {
      "id": "snoozed",
      "label": "Snoozed",
      "workflowState": "paused",
      "data": "wake_at set, hidden",
      "final": false
    },
    {
      "id": "done",
      "label": "Done",
      "workflowState": "closed",
      "data": "completed_at set",
      "final": false
    },
    {
      "id": "archived",
      "label": "Archived",
      "workflowState": "kept",
      "data": "listed = false, read-only",
      "final": false
    },
    {
      "id": "deleted",
      "label": "Deleted",
      "workflowState": "in trash",
      "data": "deleted_at set, hidden",
      "final": false
    }
  ],
  "transitions": [
    {
      "from": "draft",
      "event": "SUBMIT",
      "to": "todo",
      "actor": "user",
      "guard": "title not empty",
      "effect": "listed = true"
    },
    {
      "from": "draft",
      "event": "DELETE",
      "to": "deleted",
      "actor": "user",
      "effect": "deleted_at = now"
    },
    {
      "from": "todo",
      "event": "START",
      "to": "inProgress",
      "actor": "user",
      "effect": "started_at = now"
    },
    {
      "from": "todo",
      "event": "COMPLETE",
      "to": "done",
      "actor": "user",
      "effect": "completed_at = now"
    },
    {
      "from": "todo",
      "event": "SNOOZE",
      "to": "snoozed",
      "actor": "user",
      "effect": "wake_at = chosen time"
    },
    {
      "from": "todo",
      "event": "DELETE",
      "to": "deleted",
      "actor": "user",
      "effect": "deleted_at = now"
    },
    {
      "from": "inProgress",
      "event": "SNOOZE",
      "to": "snoozed",
      "actor": "user",
      "effect": "wake_at = chosen time"
    },
    {
      "from": "inProgress",
      "event": "COMPLETE",
      "to": "done",
      "actor": "user",
      "effect": "completed_at = now"
    },
    {
      "from": "snoozed",
      "event": "RESUME",
      "to": "inProgress",
      "actor": "user or timer",
      "effect": "wake_at = null"
    },
    {
      "from": "done",
      "event": "REOPEN",
      "to": "todo",
      "actor": "user",
      "effect": "completed_at = null"
    },
    {
      "from": "done",
      "event": "ARCHIVE",
      "to": "archived",
      "actor": "user",
      "guard": "completed_at set",
      "effect": "listed = false"
    },
    {
      "from": "archived",
      "event": "UNARCHIVE",
      "to": "done",
      "actor": "user",
      "effect": "listed = true"
    },
    {
      "from": "deleted",
      "event": "RESTORE",
      "to": "todo",
      "actor": "user",
      "effect": "deleted_at = null"
    }
  ]
}